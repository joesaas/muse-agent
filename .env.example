# Copy to .env or export in your shell. Never commit real secrets.
# Default provider is mock: the agent runs fully offline with no key.
MUSE_AGENT_PROVIDER=mock
# MUSE_AGENT_PROVIDER=openai-compatible
# MUSE_AGENT_MODEL=your-model-name
# MUSE_AGENT_BASE_URL=https://api.example.com/v1
# MUSE_AGENT_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
# MUSE_AGENT_HOME=~/.muse-agent
